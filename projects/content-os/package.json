{
  "name": "content-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local content operations: brief bookmarks -> ideas -> calendar -> headless skill generation -> review -> scheduled publishing.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "import:sheets": "node scripts/import-sheets.ts",
    "autostart:install": "node scripts/install-autostart.ts",
    "autostart:remove": "node scripts/install-autostart.ts --remove"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.6.2",
    "croner": "^9.1.0",
    "diff": "^8.0.2",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.0",
    "marked": "^18.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
