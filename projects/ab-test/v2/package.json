{
  "name": "lead-intake",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": { "node": ">=22.6" }
}
